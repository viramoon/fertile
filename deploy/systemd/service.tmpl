$owner
[Unit]
Description=Fertile $name
PartOf=fertile.target
$dependencies

[Service]
Type=exec
User=$user
Group=$group
Environment=$environment
$prepare
ExecStart=$start
$ready
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120s
TimeoutStopSec=30s
KillMode=$kill_mode
KillSignal=$kill_signal
NoNewPrivileges=yes
UMask=0027
