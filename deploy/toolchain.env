# 唯一维护源；子仓库的版本文件由此同步，变更需同批 PR 对齐。
# NautilusTrader GitHub Latest（prerelease=false）；上游仍将项目标为 Beta。
NAUTILUS_TAG=v1.231.0
NAUTILUS_COMMIT=27a8e54e7ac3c57d6cbf8891f0283dfbaee97317
# rust-toolchain.toml / Cargo.toml 的精确版本与 MSRV。
RUST_VERSION=1.97.1
RUSTUP_VERSION=1.29.3
# 上游 requires-python >=3.12,<3.15；本系统选定 3.12。
PYTHON_VERSION=3.12.13
# 上游 pyproject.toml 的 required-version。
UV_VERSION=0.11.33
# 上游要求 clang + lld，未指定最低版本；选用 Ubuntu 24 兼容的通用 LLVM 22 发行物。
LLVM_VERSION=22.1.8
NODE_VERSION=24.22.3
PNPM_VERSION=12.18.0
POSTGRES_VERSION=17.12
# Gateway 只选型，不由 bootstrap 安装或登录。
IB_GATEWAY_VERSION=10.50.1g
IBC_VERSION=3.24.2
IB_GATEWAY_SHA256=13dc8bb05cbcec8d1b0bb0b25748447cf85863fb4b94361f57fcd350f35c7a9c
IBC_SHA256=cc097ca1dfa75413a5fbe02e4743050af15f3308eb6a97c769b3cff9850c80c5
