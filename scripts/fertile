#!/usr/bin/env bash
set -euo pipefail
scripts=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=${FERTILE_ROOT:-${FERTILE_BOX_HOME:-/home/box}/fertile}
if [[ -f "$root/env.sh" ]]; then
  # shellcheck disable=SC1091
  source "$root/env.sh"
fi
export FERTILE_ROOT="$root"
export PYTHONDONTWRITEBYTECODE=1
if [[ ${1:-} == build ]]; then shift; exec "$scripts/build-release.sh" "$@"; fi
if [[ -z ${FERTILE_CONTROL_PYTHON:-} && -z ${FERTILE_SUPERVISOR_BIN:-} ]]; then
  if [[ ${1:-} == up || ${1:-} == ensure || ${1:-} == ensure-up ]]; then "$scripts/setup-supervisor.sh"; fi
fi
python=${FERTILE_CONTROL_PYTHON:-${FERTILE_SUPERVISOR_BIN:-$root/tools/supervisor/bin}/python}
[[ -x "$python" ]] || { echo "Install the bootstrap toolchain and run scripts/setup-supervisor.sh" >&2; exit 1; }
exec "$python" "$scripts/supervision.py" "$@"
