#!/usr/bin/env bash
set -euo pipefail
scripts=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=/dev/null
source "$scripts/runtime-root.sh"
root=$(fertile_root)
python=${FERTILE_CONTROL_PYTHON:-${FERTILE_SUPERVISOR_BIN:-$root/tools/supervisor/bin}/python}
[[ -x "$python" ]] || { echo "healthwatch requires the control Python from scripts/setup-supervisor.sh" >&2; exit 1; }
export PYTHONDONTWRITEBYTECODE=1 FERTILE_ROOT="$root"
exec "$python" "$scripts/healthwatch.py" "$@"
